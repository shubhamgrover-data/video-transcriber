# ClipScribe Configuration
APP_NAME=ClipScribe — Video Transcription Service
HOST=0.0.0.0
PORT=3000

# Transcription engine: auto | faster_whisper | groq | openai | demo
TRANSCRIPTION_ENGINE=auto
PREFER_YOUTUBE_CAPTIONS=true

# Optional dedicated faster-whisper HTTP container URL (e.g. http://whisper:8001)
WHISPER_SERVICE_URL=
WHISPER_SERVICE_TIMEOUT_SEC=1800
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Optional Cloud & AI Transcription API Keys
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# Media extraction settings (yt-dlp + ffmpeg)
COOKIES_FILE=
PROXY_URL=
MAX_VIDEO_DURATION_SEC=7200
CLEANUP_AUDIO=true
